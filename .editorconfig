# EditorConfig is awesome: https://EditorConfig.org

# top-most EditorConfig file
root = true

[*]
charset = utf-8
indent_style = space
indent_size = 2
max_line_length = 140
trim_trailing_whitespace = true
insert_final_newline = false
end_of_line = crlf

[.prettierrc]
indent_style = space
indent_size = 2

[*.{JSON,Json,json}]
indent_style = space
indent_size = 2

[*.{MD,md}]
indent_style = space
indent_size = 3

[*.{CSS,css}]
indent_style = tab
indent_size = 4

[*.{TS,ts}]
indent_style = tab
indent_size = 4

[*.{JS,js}]
indent_style = tab
indent_size = 4

[*.py]
indent_style = space
indent_size = 4


# EOF