{
  "name": "we-are-checkday-web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:all": "bun test && playwright test",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "storybook": "storybook dev -p 39000",
    "build-storybook": "storybook build",
    "verify": "node tools/verify.mjs",
    "verify:compare": "node tools/verify-compare.mjs",
    "verify:all": "node tools/verify.mjs && node tools/verify-compare.mjs && node tools/verify-png.mjs && node tools/verify-schema.mjs",
    "deploy": "node tools/deploy.mjs",
    "bump-version": "uv run python tools/bump_version.py"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@storybook/addon-a11y": "^10.5.9",
    "@storybook/addon-essentials": "^8.6.14",
    "@storybook/web-components-vite": "^10.5.9",
    "dotenv": "^17.4.2",
    "dotenv-cli": "^11.0.0",
    "storybook": "^10.5.9",
    "typescript": "^7.0.2",
    "vite": "^8.2.1"
  }
}
